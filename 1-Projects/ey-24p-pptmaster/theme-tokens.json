{
  "$schema": "ThemeTokens v1.0 — ppt-master standard",
  "meta": {
    "name": "EY Executive Discussion Deck — China AI Reality（前 4 页）",
    "description": "EY 安永 Executive Discussion Deck 风格 — 深海军蓝 + teal 青色 + 衬线大标题，16:9 宽屏",
    "audience": "executives / consulting clients / LELI China",
    "created_at": "2026-09-01",
    "based_on": "EY Seeing China's AI Reality 24P PDF（前 4 页 OCR 提取）",
    "method": "方案 D — OCR 精准对齐 + 原 PDF 底图"
  },
  "colors": {
    "primary": {"value": "#1B2D5C", "usage": "主色 — 标题、强调、关键图表（深海军蓝）"},
    "secondary": {"value": "#00A3B4", "usage": "辅色 — 副标题、AI 标签条、强调装饰线（teal 青色）"},
    "accent": {"value": "#1E5BA8", "usage": "强调色 — callout 高亮框、KPI 描边"},
    "neutral": {
      "black": "#000000",
      "white": "#FFFFFF",
      "gray_900": "#1F2937",
      "gray_700": "#374151",
      "gray_500": "#6B7280",
      "gray_300": "#D1D5DB",
      "gray_100": "#F3F4F6",
      "off_white": "#F9FCFF",
      "very_light_blue": "#E8F0F8"
    },
    "background": {
      "light": "#FFFFFF",
      "dark": "#0F1A3A",
      "subtle": "#F9FCFF",
      "card": "#FFFFFF",
      "card_alt": "#FBFDFF"
    }
  },
  "typography": {
    "primary_font_en": {"value": "Calibri", "fallback": "Arial, sans-serif", "usage": "英文正文"},
    "primary_font_zh": {"value": "Microsoft YaHei", "fallback": "PingFang SC, sans-serif", "usage": "中文正文"},
    "serif_font": {"value": "Georgia", "fallback": "Times New Roman, serif", "usage": "EY 衬线大标题"},
    "title_size": {
      "cover_main": "44pt",
      "section": "36pt",
      "page": "22pt",
      "data_huge": "44pt"
    },
    "body_size": {
      "large": "18pt",
      "normal": "13pt",
      "small": "11pt",
      "data_big": "32pt"
    },
    "line_height": 1.4
  },
  "spacing": {
    "page_margin": {"top": "0.4in", "bottom": "0.4in", "left": "0.5in", "right": "0.5in"},
    "title_zone_height": "1.0in",
    "footer_zone_height": "0.3in",
    "grid": {"columns": 12, "gutter": "0.15in"},
    "section_gap": "0.2in"
  },
  "page_types": {
    "cover": {"layout": "left_text_right_visual", "title_size": "44pt"},
    "agenda": {"layout": "two_column_quadrant", "title_size": "32pt"},
    "section_divider": {"layout": "left_text_right_decorative", "title_size": "36pt"},
    "data_dashboard": {"layout": "2x3_grid_cards", "data_number_size": "32pt"}
  },
  "chart_style": {
    "color_palette": ["#1B2D5C", "#00A3B4", "#1E5BA8", "#374151"],
    "grid": "minimal",
    "data_labels": "show on key values"
  },
  "speaker_notes": {"required": true, "min_length_per_slide": "20-50 字"},
  "icons": {
    "style": "linear_outline",
    "primary_color": "#1B2D5C",
    "accent_color": "#00A3B4",
    "stroke_width": "1.2pt"
  }
}